{
  "project": "Monolith",
  "platform": "ios",
  "github": {
    "owner": "YOUR_GITHUB_USERNAME",
    "repo": "monolith"
  },
  "ios": {
    "path": "ios",
    "scheme": "Runner",
    "signing": false
  },
  "flutter": {
    "watch": {
      "dirs": ["lib"],
      "patterns": [".dart"],
      "ignore": [".g.dart", ".freezed.dart"],
      "debounce": 100
    }
  }
}
